{
  "name": "anki-tetris-card",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:js": "node esbuild.config.mjs",
    "build:css": "tailwindcss -i ./src/app.css -o ./anki-tetris-card/web/style.css",
    "build": "npm run build:js && npm run build:css",
    "format": "prettier --write .",
    "format_check": "prettier --check .",
    "lint": "eslint . && npm run lint:paraglide",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "glue-fumen": "^1.0.2",
    "tetris-fumen": "^1.1.3"
  }
}
